APP_NAME=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Hosted staging/production must use APP_DEBUG=false and SESSION_SECURE_COOKIE=true.
# CSP is enforced by default. Enable report-only only for temporary staging diagnosis.
CSP_REPORT_ONLY=false
# Additional exact HTTPS/WSS origins, separated by commas; no wildcards.
CSP_CONNECT_SOURCES=
CSP_FRAME_SOURCES=
CSP_IMAGE_SOURCES=https://ui-avatars.com
# Specify only verified reverse-proxy IPs/CIDRs when TLS terminates at a proxy.
TRUSTED_PROXIES=
HSTS_MAX_AGE=86400
HSTS_INCLUDE_SUBDOMAINS=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pupt_dcms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_IDLE_TIMEOUT_SECONDS=600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_APP_NAME="${APP_NAME}"

# OIDC / Identity Provider
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
IDP_LOGIN_URL=https://identity-provider.isaxbsit2027.com/login

OIDC_AUTHORIZE_URL=https://identity-provider.isaxbsit2027.com/api/v1/auth/authorize
OIDC_TOKEN_URL=https://identity-provider.isaxbsit2027.com/api/v1/auth/token
OIDC_ME_URL=https://identity-provider.isaxbsit2027.com/api/v1/me
OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/oidc/callback

OIDC_LOGOUT_URL=https://identity-provider.isaxbsit2027.com/api/v1/auth/logout

JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
JWT_SECRET=

# FLSS
FLSS_BASE_URL=https://test-flss.alquatrilixbsit2027.com
FLSS_API_URL=https://test-flss.alquatrilixbsit2027.com/api/v1
FLSS_SYSTEM=dms
FLSS_CLIENT=dms
FLSS_HMAC_SECRET=

# GUISIS / OGOS Student API
OGOS_API_BASE_URL=https://api-guisis.dllbsit2027.com/api/v1
OGOS_M2M_TOKEN_URL=https://api-guisis.dllbsit2027.com/api/v1/auth/m2m/token
OGOS_M2M_CLIENT_ID=
OGOS_STUDENT_SEARCH_PATH=/integrations/students/profiles
OGOS_M2M_CLIENT_SECRET=

# OCMS External Admin API
OCMS_EXTERNAL_API_URL=https://clinic-ms.inaebsit2027.com/api
OCMS_EXTERNAL_API_KEY=

# OpenAI
OPENAI_CHATBOT_MODEL=gpt-5.5
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_SIGNATURE_MODEL=gpt-5.5
OPENAI_REPORT_MODEL=gpt-5.5
SIGNATURE_AI_THRESHOLD=0.65

# Local Admin Bootstrap
LOCAL_ADMIN_NAME="System Administrator"
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_FIRST_NAME=System
LOCAL_ADMIN_MIDDLE_NAME=
LOCAL_ADMIN_LAST_NAME=Administrator
LOCAL_ADMIN_SUFFIX_NAME=

# Concurrent Sessions
CONCURRENT_SESSIONS_ENABLED=true
CONCURRENT_SESSIONS_DEFAULT_LIMIT=1
CONCURRENT_SESSIONS_SUPER_ADMIN_LIMIT=1
CONCURRENT_SESSIONS_ADMIN_LIMIT=1
CONCURRENT_SESSIONS_DENTIST_LIMIT=1
CONCURRENT_SESSIONS_PATIENT_LIMIT=3
CONCURRENT_SESSIONS_STRATEGY=replace_oldest
CONCURRENT_SESSIONS_NOTIFY_ON_REPLACEMENT=true

PH_HOLIDAYS_MCP_URL=https://ph-holidays.godmode.ph/mcp
PH_HOLIDAYS_CONNECT_TIMEOUT=5
PH_HOLIDAYS_TIMEOUT=15
PH_HOLIDAYS_CACHE_HOURS=24
PH_HOLIDAYS_FALLBACK_CACHE_HOURS=6
